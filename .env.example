SERPAPI_KEY=your_serpapi_key_here

# Supabase (optional — app works without it, but caching requires it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Auth (browser-safe — used for optional magic-link sign-in)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Vercel Cron auth (set in Vercel env; used by weekly refresh job)
CRON_SECRET=generate_a_long_random_string
